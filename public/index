<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Unidad 01 · Control de tareas</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
:root{--bg:#09060f;--pn:#150d22;--pu:#7b2fd6;--pu2:#b98cff;--gr:#7dff3b;--wh:#f2eefa;--mu:#9a8fb0;--or:#ff9f2e;--bd:#3a2360}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(circle at 85% -10%,#2b1056 0,transparent 45%),var(--bg);color:var(--wh);font:500 16px Rajdhani,'Arial Narrow',sans-serif;padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}
.mono,th,#sync,.id{font-family:'Share Tech Mono',monospace}
.stripe{height:6px;background:repeating-linear-gradient(45deg,var(--or) 0 10px,#000 10px 20px)}
.w{max-width:none;margin:0 auto;padding:0 16px}
@media(min-width:1000px){.w{padding:0 100px}}
@media(min-width:761px){td:not([data-l="Tarea"]):not([data-l="Observaciones"]){white-space:nowrap}td[data-l="Tarea"]{min-width:200px}textarea.ob{min-width:280px}}
header{display:flex;align-items:center;gap:14px;padding:18px 0;flex-wrap:wrap}
h1{margin:0;font-size:clamp(22px,4.5vw,34px);letter-spacing:.1em;line-height:1}
h1 small{display:block;margin-top:6px;color:var(--gr);font:400 13px 'Share Tech Mono',monospace;letter-spacing:.15em}
#sync{margin-left:auto;font-size:13px;color:var(--gr)}#sync.off{color:var(--or)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:14px}
.stat{background:var(--pn);border:1px solid var(--bd);border-left:5px solid var(--c);padding:10px 14px;cursor:pointer;color:var(--wh);text-align:left;font:inherit;clip-path:polygon(0 0,calc(100% - 16px) 0,100% 16px,100% 100%,0 100%)}
.stat b{display:block;font-size:34px;line-height:1.1;color:var(--c)}.stat.on{background:#2a1647}
.s0{--c:#d4cde6}.s1{--c:var(--pu2)}.s2{--c:var(--or)}.s3{--c:var(--gr)}.stat.all{--c:var(--pu)}
.bar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}.bar .sp{flex:1}
input,select,textarea{background:#0e0818;border:1px solid var(--bd);color:var(--wh);padding:9px;font:inherit;min-width:0}
input:focus-visible,select:focus-visible,textarea:focus-visible,button:focus-visible{outline:2px solid var(--gr);outline-offset:1px}
.btn{border:0;background:var(--pu);color:#fff;padding:10px 18px;font:700 15px Rajdhani,sans-serif;letter-spacing:.08em;cursor:pointer;clip-path:polygon(10px 0,100% 0,calc(100% - 10px) 100%,0 100%)}
.btn.g{background:var(--gr);color:#000}.btn.o{background:#2c1952}
.tw{overflow-x:auto}table{width:100%;border-collapse:collapse}
th{text-align:left;color:var(--gr);font-size:12px;font-weight:400;letter-spacing:.12em;padding:8px;border-bottom:2px solid var(--pu);white-space:nowrap}
td{padding:10px 8px;border-bottom:1px solid #2b1c42;vertical-align:top}tr:hover td{background:#1a1030}
.id{color:var(--pu2);white-space:nowrap}
select.st{border-color:var(--c);color:var(--c);padding:5px}a{color:var(--gr)}
textarea.ob{width:100%;min-width:230px;min-height:44px;padding:6px 8px;font-size:14px;line-height:1.3;resize:vertical}
textarea.ob::placeholder{color:var(--mu)}
.act{white-space:nowrap}.act button{background:none;border:1px solid var(--bd);color:var(--wh);width:32px;height:32px;cursor:pointer}
.empty{padding:40px 10px;text-align:center;color:var(--mu)}
dialog{background:var(--pn);color:var(--wh);border:2px solid var(--pu);padding:0;width:min(580px,94vw);max-height:92vh}
dialog::backdrop{background:#000c}
form{padding:18px;display:grid;grid-template-columns:1fr 1fr;gap:12px}
form h2{grid-column:1/-1;margin:0;color:var(--gr);font-size:20px;letter-spacing:.08em}
label{display:flex;flex-direction:column;gap:4px;font-size:14px;color:var(--pu2)}.full{grid-column:1/-1}
textarea{min-height:80px;resize:vertical}
@media(max-width:760px){thead{display:none}table,tbody,tr,td{display:block}
tr{border:1px solid var(--bd);border-left:5px solid var(--pu);margin-bottom:10px;background:var(--pn)}
td{display:flex;justify-content:space-between;gap:12px;border:0;padding:6px 12px;text-align:right}
td::before{content:attr(data-l);color:var(--gr);font:400 12px 'Share Tech Mono',monospace;text-align:left}
textarea.ob{min-width:0;flex:1}
form{grid-template-columns:1fr}.bar input,.bar select{flex:1 1 140px}}
@media(prefers-reduced-motion:no-preference){#sync::before{content:"● ";animation:b 2s infinite}@keyframes b{50%{opacity:.25}}}
</style></head><body>
<div class="stripe"></div>
<div class="w">
<header>
<svg viewBox="0 0 48 48" width="48" height="48" aria-hidden="true"><polygon points="24,2 44,13 44,35 24,46 4,35 4,13" fill="none" stroke="#7dff3b" stroke-width="2"/><polygon points="24,9 39,18 39,30 24,39 9,30 9,18" fill="#7b2fd6"/><path d="M24 13l7 11-7 11-7-11z" fill="#7dff3b"/></svg>
<h1>Unidad 01<small>Control de tareas · Grupo Empresarial Torreón</small></h1>
<div id="sync">Conectando…</div>
</header>
<div class="stats" id="stats"></div>
<div class="bar">
<input id="q" type="search" placeholder="Buscar tarea o solicitante" style="flex:2 1 200px">
<select id="fp"></select><select id="fc"></select>
<span class="sp"></span>
<button class="btn o" id="bcsv">Exportar Excel</button>
<button class="btn o" id="brep">Exportar informe</button>
<button class="btn g" id="bnew">Nueva tarea</button>
</div>
<div class="tw"><table><thead><tr><th>ID</th><th>Tarea</th><th>Solicitante</th><th>Proyecto</th><th>Solicitud</th><th>Tipo</th><th>Estado</th><th>Entrega</th><th>Archivo</th><th>Observaciones</th><th></th></tr></thead><tbody id="tb"></tbody></table></div>
<div id="em" class="empty" hidden>No hay tareas con estos filtros. Crea una con «Nueva tarea».</div>
</div>
<dialog id="dlg"><form id="f">
<h2 id="ft">Nueva tarea</h2><input type="hidden" name="id">
<label class="full">Nombre de la tarea<input name="nombre" required placeholder="Editar video de avance de obra"></label>
<label>Solicitante<input name="solicitante" list="so" required></label><datalist id="so"></datalist>
<label>Proyecto<select name="proyecto"></select></label>
<label>Fecha de solicitud<input type="date" name="solicitud" required></label>
<label>Estado<select name="estado"></select></label>
<label>Categoría<select name="categoria"></select></label>
<label>Subcategoría<select name="sub"></select></label>
<label>Fecha de entrega<input type="date" name="entrega"></label>
<label>Enlace de SharePoint<input type="url" name="url" placeholder="https://"></label>
<label class="full">Observaciones<textarea name="obs"></textarea></label>
<div class="full" style="display:flex;gap:8px;justify-content:flex-end"><button type="button" class="btn o" id="cx">Cancelar</button><button class="btn g">Guardar tarea</button></div>
</form></dialog>
<script>
const P=["Cattleya","Ocobo II","Sauce","Samán","TQA VI","Varsovia"],S=["Sin iniciar","En proceso","Realizando cambios","Entregado"],
SUB={Imagen:["Redes sociales","Web page","Papelería","Impresión gran formato"],Video:["Redes sociales","YouTube","Pantallas"]},
SO=["Marketing","Gerencia","Equipo comercial","Iniciativa propia"],$=s=>document.querySelector(s);
let T=[],FS="";
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fd=d=>d?d.split("-").reverse().join("/"):"—",today=()=>new Date().toLocaleDateString("sv"),sc=s=>"s"+S.indexOf(s);
const opts=(a,all)=>(all?`<option value="">${all}</option>`:"")+a.map(x=>`<option>${esc(x)}</option>`).join("");
async function api(m,b,q=""){const r=await fetch("/api/tasks"+q,{method:m,headers:{"Content-Type":"application/json"},body:b?JSON.stringify(b):void 0});if(!r.ok)throw 0;return r.json()}
function sync(ok){const e=$("#sync");e.textContent=ok?"Sincronizado":"Sin conexión";e.className=ok?"":"off"}
async function load(){if(document.activeElement&&document.activeElement.classList.contains("ob"))return;try{T=await api("GET");sync(1)}catch{sync(0)}render()}
function list(){const q=$("#q").value.toLowerCase(),p=$("#fp").value,c=$("#fc").value;
return T.filter(t=>(!FS||t.estado===FS)&&(!p||t.proyecto===p)&&(!c||t.categoria===c)&&(!q||(t.nombre+t.solicitante+(t.obs||"")).toLowerCase().includes(q))).sort((a,b)=>b.id.localeCompare(a.id))}
function render(){
$("#stats").innerHTML=`<button class="stat all ${FS?"":"on"}" data-s=""><b>${T.length}</b>Todas</button>`+S.map(s=>`<button class="stat ${sc(s)} ${FS===s?"on":""}" data-s="${s}"><b>${T.filter(t=>t.estado===s).length}</b>${s}</button>`).join("");
const L=list();$("#em").hidden=!!L.length;
$("#tb").innerHTML=L.map(t=>`<tr><td data-l="ID" class="id">${esc(t.id)}</td><td data-l="Tarea"><b>${esc(t.nombre)}</b></td><td data-l="Solicitante">${esc(t.solicitante)}</td><td data-l="Proyecto">${esc(t.proyecto)}</td><td data-l="Solicitud">${fd(t.solicitud)}</td><td data-l="Tipo">${esc(t.categoria)} · ${esc(t.sub)}</td><td data-l="Estado"><select class="st ${sc(t.estado)}" data-id="${esc(t.id)}" aria-label="Estado">${S.map(s=>`<option${s===t.estado?" selected":""}>${s}</option>`).join("")}</select></td><td data-l="Entrega">${fd(t.entrega)}</td><td data-l="Archivo">${/^https?:\/\//i.test(t.url)?`<a href="${esc(t.url)}" target="_blank" rel="noopener">Abrir</a>`:"—"}</td><td data-l="Observaciones"><textarea class="ob" data-o="${esc(t.id)}" rows="2" placeholder="Añadir observación…" aria-label="Observaciones">${esc(t.obs)}</textarea></td><td class="act"><button data-e="${esc(t.id)}" aria-label="Editar">✎</button> <button data-d="${esc(t.id)}" aria-label="Eliminar">✕</button></td></tr>`).join("")}
const up=r=>{const i=T.findIndex(x=>x.id===r.id);i<0?T.push(r):T[i]=r};
const f=$("#f"),sub=()=>f.sub.innerHTML=opts(SUB[f.categoria.value]);
function open(t){t=t||{solicitud:today(),estado:S[0],categoria:"Imagen",proyecto:P[0]};$("#ft").textContent=t.id?"Editar "+t.id:"Nueva tarea";f.reset();
for(const k of["id","nombre","solicitante","proyecto","solicitud","estado","categoria"])f[k].value=t[k]||"";sub();f.sub.value=t.sub||SUB[f.categoria.value][0];f.entrega.value=t.entrega||"";f.url.value=t.url||"";f.obs.value=t.obs||"";$("#dlg").showModal()}
f.categoria.onchange=sub;$("#cx").onclick=()=>$("#dlg").close();$("#bnew").onclick=()=>open();
f.onsubmit=async e=>{e.preventDefault();const d=Object.fromEntries(new FormData(f));if(d.estado==="Entregado"&&!d.entrega)d.entrega=today();
try{up(await api("PUT",d));$("#dlg").close();sync(1);render()}catch{alert("No se pudo guardar. Revisa la conexión e inténtalo de nuevo.")}};
$("#tb").onchange=async e=>{const el=e.target,t=T.find(x=>x.id===(el.dataset.id||el.dataset.o));if(!t)return;
if(el.dataset.o){const prev=t.obs;t.obs=el.value;try{up(await api("PUT",t));sync(1)}catch{t.obs=prev;alert("No se pudo guardar la observación.")}render();return}
t.estado=el.value;if(t.estado==="Entregado"&&!t.entrega)t.entrega=today();
try{up(await api("PUT",t))}catch{alert("No se pudo guardar el cambio de estado.")}render()};
$("#tb").onclick=async e=>{const b=e.target.closest("button");if(!b)return;
if(b.dataset.e)open(T.find(x=>x.id===b.dataset.e));
if(b.dataset.d&&confirm("¿Eliminar "+b.dataset.d+"? Esta acción no se puede deshacer.")){try{await api("DELETE",0,"?id="+b.dataset.d);T=T.filter(x=>x.id!==b.dataset.d)}catch{alert("No se pudo eliminar.")}render()}};
$("#stats").onclick=e=>{const b=e.target.closest("button");if(b){FS=b.dataset.s;render()}};
["#q","#fp","#fc"].forEach(s=>$(s).oninput=render);
function dl(txt,name,type){const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([txt],{type}));a.download=name;a.click()}
$("#bcsv").onclick=()=>{const H=["ID","Tarea","Solicitante","Proyecto","Fecha de solicitud","Categoría","Subcategoría","Estado","Fecha de entrega","Enlace","Observaciones"],
q=v=>'"'+String(v??"").replace(/"/g,'""')+'"';
dl("\ufeff"+[H,...list().map(t=>[t.id,t.nombre,t.solicitante,t.proyecto,t.solicitud,t.categoria,t.sub,t.estado,t.entrega,t.url,t.obs])].map(r=>r.map(q).join(";")).join("\n"),"tareas-"+today()+".csv","text/csv")};
$("#brep").onclick=()=>{const L=list(),c=S.map(s=>`<div><b>${L.filter(t=>t.estado===s).length}</b>${s}</div>`).join("");
const r=L.map(t=>`<tr><td>${esc(t.id)}</td><td>${esc(t.nombre)}</td><td>${esc(t.solicitante)}</td><td>${esc(t.proyecto)}</td><td>${fd(t.solicitud)}</td><td>${esc(t.categoria)} · ${esc(t.sub)}</td><td>${esc(t.estado)}</td><td>${fd(t.entrega)}</td><td>${/^https?:\/\//i.test(t.url)?`<a href="${esc(t.url)}">Abrir</a>`:"—"}</td><td>${esc(t.obs)}</td></tr>`).join("");
dl(`<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Informe de tareas</title><style>body{font:15px Arial,sans-serif;margin:0;color:#1b1229}header{background:#150d22;color:#fff;padding:22px 28px;border-bottom:6px solid #7dff3b}h1{margin:0;font-size:24px}header p{margin:6px 0 0;color:#b98cff}.k{display:flex;gap:12px;padding:18px 28px;flex-wrap:wrap}.k div{border-left:5px solid #7b2fd6;background:#f3edfb;padding:10px 16px}.k b{display:block;font-size:28px;color:#7b2fd6}.t{padding:0 28px 28px;overflow-x:auto}table{border-collapse:collapse;width:100%}th{background:#7b2fd6;color:#fff;text-align:left;padding:8px}td{padding:8px;border-bottom:1px solid #ddd;vertical-align:top}@media print{header{-webkit-print-color-adjust:exact;print-color-adjust:exact}}</style></head><body><header><h1>Informe de tareas · Diseño y producción audiovisual</h1><p>Grupo Empresarial Torreón · Generado el ${fd(today())} · ${L.length} tareas</p></header><div class="k">${c}</div><div class="t"><table><thead><tr><th>ID</th><th>Tarea</th><th>Solicitante</th><th>Proyecto</th><th>Solicitud</th><th>Tipo</th><th>Estado</th><th>Entrega</th><th>Archivo</th><th>Observaciones</th></tr></thead><tbody>${r}</tbody></table></div></body></html>`,"informe-tareas-"+today()+".html","text/html")};
$("#fp").innerHTML=opts(P,"Todos los proyectos");$("#fc").innerHTML=opts(["Imagen","Video"],"Imagen y video");
f.proyecto.innerHTML=opts(P);f.estado.innerHTML=opts(S);f.categoria.innerHTML=opts(["Imagen","Video"]);$("#so").innerHTML=opts(SO);
document.addEventListener("visibilitychange",()=>{if(!document.hidden)load()});setInterval(load,60000);load();
</script></body></html>
